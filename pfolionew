<!DOCTYPE html>
<html>
<head>

<title>Digital Portfolio</title>

<meta name="viewport" content="width=device-width, initial-scale=1">


<style>

*{
box-sizing:border-box;
}


html{
scroll-behavior:smooth;
}


body{

margin:0;

font-family:
Inter,
Segoe UI,
Arial,
sans-serif;


background:

linear-gradient(
180deg,
#090d14,
#111827
);


color:white;

overflow-x:hidden;

}



/* NAVBAR */

.navbar{

height:72px;

position:fixed;

top:0;

left:0;

width:100%;


display:flex;

align-items:center;

justify-content:space-between;


padding:0 70px;


background:

rgba(10,15,25,.75);


backdrop-filter:

blur(18px);


border-bottom:

1px solid rgba(255,255,255,.08);


z-index:100;

}



.logo{

font-size:23px;

font-weight:700;

letter-spacing:3px;

}


.logo span{

color:#4f9cff;

}




.nav-links{

display:flex;

gap:35px;

}



.nav-links a{

text-decoration:none;

color:#b8c1d1;

font-size:15px;

transition:.3s;

}



.nav-links a:hover{

color:white;

}






/* HERO */

.hero{


min-height:82vh;


display:flex;


flex-direction:column;


align-items:center;


justify-content:center;


text-align:center;


padding-top:70px;


}



.hero h1{


font-size:68px;


letter-spacing:10px;


margin:0;



background:

linear-gradient(

90deg,

#fff,

#78aaff

);


-webkit-background-clip:text;

color:transparent;


}



.hero p{


font-size:19px;


color:#9aa7ba;


max-width:600px;


margin-top:20px;


}



.btn{


margin-top:30px;


display:inline-block;


padding:13px 30px;


border-radius:30px;


background:white;


color:#111;


text-decoration:none;


font-weight:600;


transition:.3s;


}



.btn:hover{

transform:translateY(-3px);

}







/* PORTFOLIO */

.portfolio{


padding:

60px 30px 90px;


text-align:center;


}



.title{

font-size:38px;

margin-bottom:10px;

}



.description{

color:#94a0b5;

margin-bottom:35px;

}






/* SHELF */

.shelf{


height:320px;


max-width:1050px;


margin:auto;


display:flex;


align-items:center;


justify-content:center;


overflow:visible;


}







/* SLEEVE */

.case{


height:205px;


width:22px;


flex-shrink:0;


margin-left:-5px;


position:relative;


cursor:pointer;


overflow:hidden;


transition:

width .45s ease,

height .45s ease,

margin .45s ease,

transform .45s ease;


}






/* PNG SLEEVE */

.case img{


height:100%;


width:auto;


position:absolute;


left:0;


top:0;


filter:

drop-shadow(
8px 12px 12px rgba(0,0,0,.55)
);


}







/* HOVER */

.case:hover{


width:45px;


margin-left:5px;


margin-right:5px;


transform:


translateY(-10px);


z-index:10;


}







/* OPEN */

.case.active{


height:350px;


width:290px;


margin-left:28px;


margin-right:28px;


transform:


translateY(5px);


z-index:50;


box-shadow:


0 40px 90px rgba(0,0,0,.85);


}







.case.active img{


height:100%;


width:100%;


object-fit:contain;


filter:none;

}






/* GLASS REFLECTION */

.case.active:after{


content:"";


position:absolute;


inset:0;


background:


linear-gradient(

110deg,

transparent,

rgba(255,255,255,.25),

transparent

);


pointer-events:none;


}







footer{


text-align:center;


padding:35px;


color:#667085;


font-size:14px;


}



</style>

</head>


<body>




<nav class="navbar">


<div class="logo">

WAHIDUR<span>.</span>

</div>



<div class="nav-links">

<a href="#">Home</a>

<a href="#portfolio">Work</a>

<a href="#">Services</a>

<a href="#">Contact</a>

</div>


</nav>






<section class="hero">


<h1>
DIGITAL STUDIO
</h1>


<p>
Creating modern websites, platforms and digital experiences.
</p>


<a href="#portfolio" class="btn">
Explore Projects
</a>


</section>







<section id="portfolio" class="portfolio">


<div class="title">

Featured Work

</div>


<div class="description">

A collection of selected digital projects.

</div>






<div class="shelf">



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



</div>


</section>







<footer>

© 2026 Wahidur Digital

</footer>







<script>


const cases=document.querySelectorAll(".case");


const sleeve =
"https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png";


const projects=[

"https://support-site-wahidur.web1.bookingonline.co.uk/theme/ailogo@2x.png",

sleeve,

sleeve,

sleeve,

sleeve

];



cases.forEach((item,index)=>{


item.onclick=()=>{


if(item.classList.contains("active")){


item.classList.remove("active");


item.querySelector("img").src=sleeve;


return;


}




cases.forEach(x=>{


x.classList.remove("active");


x.querySelector("img").src=sleeve;


});



item.classList.add("active");


item.querySelector("img").src=projects[index];


};


});


</script>



</body>
</html>

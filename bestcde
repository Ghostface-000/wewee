<!DOCTYPE html>
<html>
<head>

<title>Digital Studio Portfolio</title>

<meta name="viewport" content="width=device-width, initial-scale=1">


<style>

*{
box-sizing:border-box;
}


body{

margin:0;

font-family:
Inter,
Segoe UI,
Arial,
sans-serif;


background:
linear-gradient(
180deg,
#090d14,
#111827
);


color:white;

}


/* NAV */

.navbar{

height:72px;

position:fixed;

top:0;

left:0;

width:100%;


display:flex;

align-items:center;

justify-content:space-between;


padding:0 70px;


background:

rgba(10,15,25,.75);

backdrop-filter:blur(18px);


border-bottom:1px solid rgba(255,255,255,.1);


z-index:100;

}


.logo{

font-size:24px;

font-weight:700;

letter-spacing:3px;

}


.logo span{

color:#4f9cff;

}



.nav-links{

display:flex;

gap:35px;

}


.nav-links a{

color:#b8c1d1;

text-decoration:none;

}





/* HERO */


.hero{

height:65vh;

display:flex;

align-items:center;

justify-content:center;

flex-direction:column;

text-align:center;

padding-top:70px;

}


.hero h1{

font-size:65px;

letter-spacing:10px;

margin:0;

background:

linear-gradient(
90deg,
white,
#78aaff
);


-webkit-background-clip:text;

color:transparent;

}



.hero p{

color:#9aa7ba;

font-size:20px;

}





/* WORK */


.portfolio{

padding:60px 40px 100px;

text-align:center;

}



.title{

font-size:42px;

}



.description{

color:#94a0b5;

margin-bottom:50px;

}





.gallery{


max-width:1100px;


margin:auto;


display:grid;


grid-template-columns:

repeat(4,1fr);


grid-template-rows:

250px 250px;


gap:25px;


}




.item{


border-radius:22px;


overflow:hidden;


cursor:pointer;


position:relative;


background:#111;


transition:.4s;


}



.item:hover{

transform:translateY(-8px);

}



.item.feature{


grid-column:

span 2;


grid-row:

span 2;


}




.item img{


width:100%;


height:100%;


object-fit:cover;


transition:.5s;


}



.item:hover img{


transform:scale(1.08);


}




.caption{


position:absolute;


bottom:0;


left:0;


right:0;


padding:25px;


text-align:left;


background:

linear-gradient(
transparent,
rgba(0,0,0,.9)
);


}



.caption h3{

margin:0;

font-size:22px;

}



.caption p{

margin:6px 0 0;

color:#b8c1d1;

font-size:14px;

}





/* LIGHTBOX */


.lightbox{


position:fixed;


inset:0;


background:

rgba(0,0,0,.9);


display:none;


align-items:center;


justify-content:center;


z-index:200;


}



.lightbox.active{

display:flex;

}



.lightbox img{


max-width:80%;


max-height:80%;


border-radius:20px;


box-shadow:

0 40px 100px black;


animation:

zoom .35s;


}



@keyframes zoom{

from{

transform:scale(.8);

opacity:0;

}

to{

transform:scale(1);

opacity:1;

}

}




.close{


position:absolute;


top:35px;


right:45px;


font-size:45px;


cursor:pointer;


}



.arrow{


position:absolute;


top:50%;


transform:translateY(-50%);


font-size:55px;


cursor:pointer;


padding:20px;


}



.left{

left:40px;

}


.right{

right:40px;

}





@media(max-width:900px){


.gallery{

grid-template-columns:1fr;

}


.item.feature{

grid-column:auto;

grid-row:auto;

}


.hero h1{

font-size:40px;

}


}


</style>


</head>


<body>



<nav class="navbar">

<div class="logo">

WAHIDUR<span>.</span>

</div>


<div class="nav-links">

<a href="#">Home</a>

<a href="#work">Work</a>

<a href="#">Contact</a>

</div>


</nav>






<section class="hero">

<h1>

CREATIVE WORK

</h1>


<p>

Graphic design, branding and digital experiences.

</p>

</section>







<section id="work" class="portfolio">


<div class="title">

Selected Projects

</div>


<div class="description">

A collection of graphic design work.

</div>





<div class="gallery">



<div class="item feature">

<img src="https://placehold.co/1000x1000/2563eb/ffffff?text=Main+Design">

<div class="caption">

<h3>
Brand Campaign
</h3>

<p>
Featured Artwork
</p>

</div>

</div>




<div class="item">

<img src="https://placehold.co/600x600/ec4899/ffffff?text=Poster">

<div class="caption">

<h3>
Poster Design
</h3>

</div>

</div>



<div class="item">

<img src="https://placehold.co/600x600/10b981/ffffff?text=Logo">

<div class="caption">

<h3>
Logo Design
</h3>

</div>

</div>



<div class="item">

<img src="https://placehold.co/600x600/f97316/ffffff?text=Social">

<div class="caption">

<h3>
Social Media
</h3>

</div>

</div>



<div class="item">

<img src="https://placehold.co/600x600/8b5cf6/ffffff?text=Artwork">

<div class="caption">

<h3>
Creative Artwork
</h3>

</div>

</div>



</div>


</section>






<div class="lightbox">


<div class="close">
×
</div>


<div class="arrow left">
‹
</div>


<img id="preview">


<div class="arrow right">
›
</div>


</div>







<script>


const items=document.querySelectorAll(".item img");

const lightbox=document.querySelector(".lightbox");

const preview=document.getElementById("preview");


let current=0;


const images=[...items].map(x=>x.src);



items.forEach((img,index)=>{


img.onclick=()=>{


current=index;


openImage();


};


});



function openImage(){

preview.src=images[current];

lightbox.classList.add("active");

}




document.querySelector(".close").onclick=()=>{

lightbox.classList.remove("active");

};



lightbox.onclick=(e)=>{


if(e.target===lightbox){

lightbox.classList.remove("active");

}


};



document.querySelector(".left").onclick=()=>{


current--;


if(current<0)

current=images.length-1;


openImage();


};



document.querySelector(".right").onclick=()=>{


current++;


if(current>=images.length)

current=0;


openImage();


};





document.addEventListener("keydown",e=>{


if(e.key==="Escape")

lightbox.classList.remove("active");


if(e.key==="ArrowRight")

document.querySelector(".right").click();


if(e.key==="ArrowLeft")

document.querySelector(".left").click();


});



</script>



</body>
</html>

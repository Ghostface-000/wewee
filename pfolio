<!DOCTYPE html>
<html>
<head>

<title>Portfolio Showcase</title>

<meta name="viewport" content="width=device-width, initial-scale=1">


<style>

*{
    box-sizing:border-box;
}


html{
    scroll-behavior:smooth;
}


body{

    margin:0;

    font-family:
    Inter,
    Arial,
    sans-serif;


    background:
    linear-gradient(
    180deg,
    #0b0f17,
    #151b27
    );


    color:white;

    overflow-x:hidden;

}





/* NAVBAR */

.navbar{

    height:75px;

    width:100%;


    display:flex;

    align-items:center;

    justify-content:space-between;


    padding:0 70px;


    background:

    rgba(10,14,22,.85);


    backdrop-filter:blur(15px);


    border-bottom:

    1px solid rgba(255,255,255,.08);


    position:fixed;

    top:0;

    z-index:100;

}





.logo{

    font-size:24px;

    font-weight:700;

    letter-spacing:2px;

}



.logo span{

    color:#6ea8ff;

}





.nav-links{

    display:flex;

    gap:35px;

}



.nav-links a{


    color:#ddd;


    text-decoration:none;


    font-size:15px;


    transition:.3s;


}



.nav-links a:hover{

    color:white;

}





/* HERO */

.hero{

    min-height:90vh;


    display:flex;


    flex-direction:column;


    justify-content:center;


    align-items:center;


    text-align:center;


    padding-top:80px;


}



.hero h1{


    font-size:72px;


    letter-spacing:8px;


    margin:0;


    background:

    linear-gradient(

    90deg,

    #fff,

    #7aa7ff

    );


    -webkit-background-clip:text;


    color:transparent;


}




.hero p{


    margin-top:20px;


    color:#aab3c5;


    font-size:20px;


}





.buttons{

    margin-top:35px;

}



.btn{


    display:inline-block;


    padding:14px 30px;


    border-radius:30px;


    text-decoration:none;


    margin:0 8px;


    transition:.3s;


}



.primary{


    background:#6ea8ff;

    color:#000;


}



.secondary{


    border:1px solid rgba(255,255,255,.25);

    color:white;


}



.btn:hover{


    transform:translateY(-3px);


}








/* PORTFOLIO SECTION */

.portfolio{


    padding:80px 40px;


    text-align:center;


}




.section-title{


    font-size:40px;


    margin-bottom:15px;


}



.section-text{


    color:#9fa8ba;


    margin-bottom:50px;


}






/* SHELF */

.shelf{


    height:520px;


    max-width:1200px;


    margin:auto;


    display:flex;


    justify-content:center;


    align-items:center;


    overflow:visible;


}






/* SLEEVE */

.case{


    height:420px;


    width:28px;


    flex-shrink:0;


    margin-left:-8px;


    position:relative;


    cursor:pointer;


    overflow:hidden;


    transition:.45s ease;


}





.case img{


    height:100%;


    width:auto;


    position:absolute;


    left:0;


    top:0;


}






/* HOVER */

.case:hover{


    width:55px;


    margin-left:5px;


    margin-right:5px;


    transform:


    translateY(-15px);


    z-index:10;


}







/* OPEN */

.case.active{


    width:380px;


    height:500px;


    margin-left:35px;


    margin-right:35px;


    transform:


    translateY(10px);


    z-index:50;


    box-shadow:


    0 50px 120px rgba(0,0,0,.8);


}





.case.active img{


    width:100%;


    height:100%;


    object-fit:contain;


}







.case.active:after{


    content:"";


    position:absolute;


    inset:0;


    background:


    linear-gradient(

    110deg,

    transparent,

    rgba(255,255,255,.25),

    transparent

    );


    pointer-events:none;


}






/* FOOTER */

footer{


    padding:40px;

    text-align:center;

    color:#777;


    border-top:

    1px solid rgba(255,255,255,.08);


}





</style>


</head>



<body>




<nav class="navbar">


<div class="logo">

WAHIDUR<span>.</span>

</div>


<div class="nav-links">

<a href="#">Home</a>

<a href="#portfolio">Portfolio</a>

<a href="#">Services</a>

<a href="#">Contact</a>

</div>


</nav>







<section class="hero">


<h1>
DIGITAL CREATIVE
</h1>


<p>
Websites, systems and digital experiences built with precision.
</p>



<div class="buttons">

<a class="btn primary" href="#portfolio">
View Work
</a>


<a class="btn secondary" href="#">
Contact
</a>


</div>


</section>







<section id="portfolio" class="portfolio">


<div class="section-title">
Selected Work
</div>


<div class="section-text">
Browse through our latest digital projects.
</div>




<div class="shelf">



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



<div class="case">

<img src="https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png">

</div>



</div>


</section>






<footer>

© 2026 Wahidur Digital. All Rights Reserved.

</footer>






<script>


const cases=document.querySelectorAll(".case");


const sleeveImage =
"https://support-site-wahidur.web1.bookingonline.co.uk/theme/1sleeve.png";


const projects=[

"https://support-site-wahidur.web1.bookingonline.co.uk/theme/ailogo@2x.png",

sleeveImage,

sleeveImage,

sleeveImage,

sleeveImage

];



cases.forEach((item,index)=>{


item.onclick=()=>{


if(item.classList.contains("active")){


item.classList.remove("active");


item.querySelector("img").src=sleeveImage;


return;


}




cases.forEach((x)=>{


x.classList.remove("active");


x.querySelector("img").src=sleeveImage;


});



item.classList.add("active");


item.querySelector("img").src=projects[index];



};


});



</script>



</body>
</html>
